    {
      "id": "equivalent-fractions",
      "version": 1,
      "domainIds": [
        "elementary-mathematics"
      ],
      "topicIds": [
        "elementary-mathematics-arithmetic"
      ],
      "type": "theorem",
      "title": "Equivalent fractions",
      "titleZh": "等值分数",
      "statement": "For integers a, b and k with b ≠ 0 and k ≠ 0, a/b = (ka)/(kb).",
      "scope": "Rational numbers; the shaded bar illustrates the positive case only.",
      "objectives": [
        "Explain why nonzero common scaling preserves a rational value.",
        "Identify excluded zero denominators and zero scale factors."
      ],
      "conditions": [
        "a, b and k are integers.",
        "b ≠ 0 and k ≠ 0."
      ],
      "system": "The rational number system.",
      "proof": "Multiplying by k/k = 1 preserves a/b. The assumptions guarantee that b and kb are nonzero. This draft proof and examples await independent review.",
      "sources": [
        {
          "kind": "original",
          "author": "Math Master project",
          "title": "Elementary fractions editorial draft",
          "url": "",
