{
    default_sni {$PUBLIC_HOST}
}

https://{$PUBLIC_HOST} {
    tls {
        issuer acme {
            dir {$ACME_DIRECTORY}
            profile shortlived
        }
    }
    @health {
        method GET
        path /healthz /readyz
    }
    handle @health {
        reverse_proxy api:8080
    }
    handle {
        reverse_proxy web:3000
    }
}
