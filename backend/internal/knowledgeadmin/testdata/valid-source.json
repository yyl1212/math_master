    {
      "id": "demo-equivalent-fractions",
      "version": 1,
      "title": "Equivalent fractions",
      "title_zh": "等值分数",
      "type": "theorem",
      "type_status": "confirmed",
      "subtype": "fraction-equivalence",
      "content_origin": "original",
      "statement": "若 $b\\ne0$ 且 $c\\ne0$，则 $a/b=(ac)/(bc)$。",
      "conditions": [
        "$a,b,c\\in\\mathbb{Z}$。",
        "$b\\ne0$ 且 $c\\ne0$。"
      ],
      "scope": "有理分数的等值变换，适用于正、负非零倍数。",
      "system": "有理数及其通常运算",
      "objectives": [
        "说明该知识点的含义，并检查适用条件。"
      ],
      "msc_codes": [
        "97F40"
      ],
      "classification_status": "confirmed",
      "classification_evidence": [
        {
          "msc_code": "97F40",
          "reason": "内容用于整数与有理数的基础教学。",
          "evidence_fields": [
            "statement",
            "conditions",
            "scope"
          ],
          "kind": "specific"
        }
      ],
      "learning_difficulty": {
        "difficulty_level": 2,
        "rationale": "需要理解非零因子的约去和含字母的分数等值变换。",
        "prerequisites": [
          "整数",
          "乘法和除法"
        ],
        "review_status": "body_assessed",
        "rubric_version": "learning-foundation-v1-20261008",
        "proof_scope_note": "只评估示例中给出的这一步代数证明，不扩展到其他分式命题。"
      },
      "proof": "由于 $c\\ne0$，有 $c/c=1$。因此 $a/b=(a/b)\\cdot(c/c)=(ac)/(bc)$；两处分母均非零。",
      "proof_scope": "full",
      "equations": [],
      "explanations": [
        {
          "kind": "formal",
          "body": "分子和分母同乘非零数，相当于整个分数乘以1。"
        }
      ],
      "examples": [
        "$2/3=(2\\cdot2)/(3\\cdot2)=4/6$。"
      ],
      "counterexamples": [
        "取 $c=0$ 会产生 $0/0$，说明非零条件不可删去。"
      ],
