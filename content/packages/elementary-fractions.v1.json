  "units": [
    {
      "id": "equivalent-fractions-introduction",
      "version": 1,
      "knowledge": {
        "id": "equivalent-fractions",
        "version": 1
      },
      "angles": [
        {
          "kind": "visual",
          "body": "One shaded half and two shaded fourths cover the same amount. The bars illustrate positive fractions only.\n\n![Equal shaded amounts](asset:equivalent-fractions-diagram)"
        },
        {
          "kind": "formal",
          "body": "For b ≠ 0 and k ≠ 0, multiplying a/b by k/k gives (ka)/(kb). Both fractions denote the same rational number."
        }
      ],
      "examples": [
        "1/2 = 2/4: use k = 2.",
        "(-1)/2 = (-3)/6: use k = 3.",
        "1/2 = (-1)/(-2): use k = -1."
      ],
      "counterexamples": [
        "k = 0 is excluded: 0/0 has no rational value.",
        "1/2 and 2/3 differ: increasing both entries by one does not preserve a fraction."
      ],
      "assetIds": [
        "equivalent-fractions-diagram"
      ]
    }
